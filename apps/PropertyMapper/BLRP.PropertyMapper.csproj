<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>..\..\branding\BLRP.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>BLRP.PropertyMapper</AssemblyName>
    <Version>1.0.0</Version>
    <Company>BadlandsRP</Company>
    <Product>BLRP Property Mapper</Product>
    <Description>Reviews property mapping XML and exports deployable YMAP assets.</Description>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\shared\BlrpTheme.cs" Link="BlrpTheme.cs" />
    <Reference Include="CodeWalker.Core"><HintPath>..\..\shared\lib\CodeWalker.Core.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="SharpDX"><HintPath>..\..\shared\lib\SharpDX.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="SharpDX.Mathematics"><HintPath>..\..\shared\lib\SharpDX.Mathematics.dll</HintPath><Private>true</Private></Reference>
  </ItemGroup>
</Project>
