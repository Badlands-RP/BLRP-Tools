<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>BLRP.LiveryPreview</AssemblyName>
    <Version>1.0.48</Version>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <BadWalkerDirectory Condition="'$(BadWalkerDirectory)' == ''">$(MSBuildThisFileDirectory)..\..\release\staging\BLRP-Tools\tools\BadWalker</BadWalkerDirectory>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="BLRP.LiveryPreview.Checks" />
    <Compile Include="..\..\shared\LiveryTheme.cs" Link="LiveryTheme.cs" />
    <Compile Include="..\..\shared\LiveryPreviewMaterials.cs" Link="LiveryPreviewMaterials.cs" />
    <Reference Include="CodeWalker"><HintPath>$(BadWalkerDirectory)\CodeWalker.exe</HintPath><Private>false</Private></Reference>
    <Reference Include="CodeWalker.Core"><HintPath>$(BadWalkerDirectory)\CodeWalker.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SharpDX"><HintPath>$(BadWalkerDirectory)\SharpDX.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SharpDX.Mathematics"><HintPath>$(BadWalkerDirectory)\SharpDX.Mathematics.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SharpDX.Direct3D11"><HintPath>$(BadWalkerDirectory)\SharpDX.Direct3D11.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SharpDX.DXGI"><HintPath>$(BadWalkerDirectory)\SharpDX.DXGI.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="CheckPublishedRenderer" BeforeTargets="ResolveAssemblyReferences" Condition="!Exists('$(BadWalkerDirectory)\CodeWalker.exe')">
    <Error Text="Set BadWalkerDirectory to tools/BadWalker in a published BLRP Tools package, or run Build-Package.ps1 to obtain the pinned renderer. A CodeWalker source build is not required." />
  </Target>
</Project>
